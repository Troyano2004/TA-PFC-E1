<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" agent="SIC-UTEQ" version="24.7.17"><diagram id="c4-nivel1" name="C4 nivel 1 - Contexto"><mxGraphModel dx="1480" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;SIC-UTEQ: diagrama de contexto (C4, nivel 1)&lt;/b&gt;&lt;br&gt;Versión E1, 21-11-2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="420" height="50" as="geometry"/></mxCell><mxCell id="p_est" value='&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Registra su propuesta de tema, sube las versiones de su documento y consulta observaciones, fechas y notas.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="90" width="240" height="130" as="geometry"/></mxCell><mxCell id="p_doc" value='&lt;b&gt;Docente&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Como director revisa el documento y registra observaciones; como miembro del tribunal califica la sustentación.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="240" height="130" as="geometry"/></mxCell><mxCell id="p_coo" value='&lt;b&gt;Coordinador y comisión de titulación&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Revisan y aprueban propuestas, asignan director y tribunal, configuran el periodo y generan actas.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="90" width="240" height="130" as="geometry"/></mxCell><mxCell id="p_adm" value='&lt;b&gt;Administrador del sistema&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Gestiona usuarios, roles, correo y respaldos.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="240" height="130" as="geometry"/></mxCell><mxCell id="sis" value='&lt;b&gt;SIC-UTEQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Gestiona el proceso de titulación de la Unidad de Integración Curricular: propuestas, documento de titulación, revisiones, sustentación, calificaciones y actas.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="540" height="150" as="geometry"/></mxCell><mxCell id="e_p_est" value="Usa&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_est" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_p_doc" value="Usa&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3700;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_doc" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_p_coo" value="Usa&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6300;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_coo" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_p_adm" value="Usa&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_adm" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_mail" value='&lt;b&gt;Servidor de correo institucional&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Envía los avisos por correo electrónico.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_mail" value="Envía avisos&lt;br&gt;[SMTP]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0600;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_drive" value='&lt;b&gt;Google Drive&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Guarda los archivos de los documentos de titulación.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_drive" value="Guarda y lee archivos&lt;br&gt;[API REST, HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.2400;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_drive"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_ia" value='&lt;b&gt;Servicios de IA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Gemini y Groq para la revisión asistida; un servicio externo para detectar texto generado.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_ia" value="Pide revisiones&lt;br&gt;[API REST, HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.4200;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_ia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_zoom" value='&lt;b&gt;Zoom&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Reuniones virtuales de tutoría y de sustentación.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_zoom" value="Crea reuniones&lt;br&gt;[API REST, HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5800;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_zoom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_sga" value='&lt;b&gt;SGA de la UTEQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Sistema académico institucional. No hay conexión directa: se exportan pensum, requisitos y deudas en Excel.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_sga" value="Importa archivos Excel&lt;br&gt;exportados del SGA" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.7600;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_sga"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_resp" value='&lt;b&gt;Almacenamiento de respaldos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Azure Blob Storage o Amazon S3, según la configuración.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="640" width="210" height="130" as="geometry"/></mxCell><mxCell id="e_x_resp" value="Envía respaldos&lt;br&gt;[API REST, HTTPS]" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.9400;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sis" target="x_resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Azul oscuro: personas. Azul: el sistema que construimos. Gris: sistemas externos que ya existen.&lt;br&gt;Línea continua: comunicación directa. Línea discontinua: intercambio indirecto (archivos exportados a mano).&lt;br&gt;El detalle de los contenedores está en c4-nivel2-contenedores.drawio." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="760" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
